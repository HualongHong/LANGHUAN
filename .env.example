# ============================================================================
# LangHuan 套件根级占位符模板（.env.example）—— 严禁填入真实值入库。
# 真实 key 只放本地 .env（已被 .gitignore 排除）。各技能的 provider key
# 模板另见各技能目录内的 .env.example。
# ============================================================================

# ---- Credential broker 预留位（D7，可选增强，fail-open）----
# LangHuan 技能经 agentkit.credentials 接缝解析 provider key：宿主（如
# DSH Capsule）注册 credential broker 时经 broker 解析（不落盘、不跨
# operation 缓存）；无 broker 时自动回落到本文件/技能 .env 的环境变量
# 路径，行为与现状完全一致（Capsule 永不成为硬依赖）。
# 现阶段仅预留占位，留空即可；未来宿主 broker 的接入点名由此变量声明：
# AGENTKIT_CREDENTIAL_BROKER=

# ---- 常见 provider key（全部占位留空/注释；真实值放本地 .env）----
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# KIMI_API_KEY=
# QWEN_API_KEY=
# MINIMAX_API_KEY=
# GEMINI_API_KEY=
# CLAUDE_API_KEY=
