# Archive-Plate-Assembler 调试用 API Key 配置
# 使用方法：复制本文件为 .env 并填入真实密钥。.env 已在 .gitignore 中排除，切勿提交。

# 模型 A（主提取）：MiniMax —— https://platform.minimaxi.com/ （OpenAI 兼容接口）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=

# 模型 B（校验）：Qwen —— 阿里云百炼 DashScope（OpenAI 兼容模式）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

# 备选：Kimi —— Moonshot AI 开放平台 https://platform.moonshot.cn/
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=

# 模型网关通用设置
# 所有调用必须开启供应商的"数据不用于训练"隐私选项（设定书 §5）
MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=3

# —— P1b：角色 profile / 缓存 / 宿主桥接（均为可选，默认不变）——
# 角色 provider 覆盖：取 agentkit 注册表中的 provider 名；
# 设为 agent_bridge 时该角色改走宿主工单队列（无需对应 API key）。
# agent_run --mode collect/apply 会自动把两个角色都设为 agent_bridge。
# APA_ROLE_A_PROVIDER=minimax
# APA_ROLE_B_PROVIDER=qwen

# LLM 内容缓存（默认关闭）：值为独立 SQLite 文件路径。
# 缓存值是剥离 <think>/``` 围栏后的清洗文本，切勿与其他缓存混用同一文件。
# APA_LLM_CACHE_DB=output/.apa_cache.db

# 宿主工单队列（agent_bridge）：队列目录与模式；agent_run 的
# collect/apply 模式会自动设置为 <workdir>/.apa_llm 与对应模式。
# AGENTKIT_LLM_DIR=.apa_llm
# AGENTKIT_LLM_MODE=collect

# 图像处理
PDF_RENDER_DPI=300
