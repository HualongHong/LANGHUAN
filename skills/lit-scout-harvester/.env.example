# Example environment file for LangHuan Suite.
# Copy to .env and fill in your own keys. .env is ignored by git.

# DeepSeek API credentials (default)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional: other LLM providers used in llm.models profiles
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# KIMI_API_KEY=sk-your-key-here
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# QWEN_API_KEY=sk-your-key-here
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MINIMAX_API_KEY=your-key-here
# MINIMAX_GROUP_ID=your-group-id

# GEMINI_API_KEY=your-key-here

# ANTHROPIC_API_KEY=sk-ant-api-your-key-here
# ANTHROPIC_BASE_URL 通常不需要，使用官方端点时可留空

# Optional: host capability lease reference recorded in CITATION.md (B3),
# format "lease-id:ttl". Set by the host (e.g. Capsule); leave unset for normal runs.
# AGENTKIT_HOST_LEASE=lease-id:300

# Optional: email registered in the OpenAlex polite pool (used by the OpenAlex
# online datasource parser and scripts/verify_references.py). Defaults to a
# placeholder address; set your own to enter the polite pool (higher limits).
# AGENTKIT_OPENALEX_MAILTO=your-email@example.com

